# Anthropic Claude API key — powers the chat model in /api/chat
ANTHROPIC_API_KEY=

# OpenAI API key — used to embed the user query for product retrieval AND to
# synthesize speech for voice mode (/api/tts).
OPENAI_API_KEY=

# --- Text-to-speech (voice mode, /api/tts) ----------------------------------
# OpenAI TTS model. Default gpt-4o-mini-tts (current cost-efficient model,
# multilingual, ~$15.9 / 1M characters as of 2026-06). The `instructions`
# steering below is only sent for gpt-4o(-mini)-tts; legacy tts-1 / tts-1-hd
# ignore/reject it, so it's gated on the model family in code.
TTS_MODEL=gpt-4o-mini-tts

# TTS voice. Default "coral" — warm, friendly and UPBEAT, clean German
# pronunciation; picked so Mo sounds energetic/motivating rather than flat.
# Other lively choices: ash (confident), verse (expressive), ballad (emotive).
# Full set: alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer,
# verse, marin, cedar.
TTS_VOICE=coral

# Speaking rate. Default 1.1 (slightly brisk → more energetic, and the audio
# keeps up with the streamed text in voice mode). Range 0.25–4.0; values are
# clamped. NB: only legacy tts-1 / tts-1-hd take this as the numeric `speed`
# param — the default gpt-4o(-mini)-tts ignores `speed`, so the rate is applied
# as a tempo hint folded into TTS_INSTRUCTIONS instead. Set 1.0 for neutral pace.
TTS_SPEED=1.1

# Optional tone/accent steering for gpt-4o(-mini)-tts. Defaults to a friendly,
# energetic, motivating Hochdeutsch instruction (a tempo hint scaled by TTS_SPEED
# is appended automatically). Set empty or override to change the speaking style.
TTS_INSTRUCTIONS=

# Comma-separated list of browser origins allowed to call the API
# (CORS allowlist). Falls back to https://www.motionsports.de,https://motionsports.de
ALLOWED_ORIGINS=https://www.motionsports.de,https://motionsports.de

# Shared secret the frontend must send in the `x-ms-chat-key` header
# on every /api/chat and /api/contact request. Generate a long random string.
CHAT_SHARED_SECRET=

# --- Upstash Redis (rate limiting) ------------------------------------------
# Connection for the per-client rate limiter (sliding-window buckets, e.g.
# 20 chat requests / 60 s). Vercel's Upstash Marketplace integration injects
# these two automatically under the KV_* names — you normally do NOT set them by
# hand in production. REQUIRED: the rate limiter builds its Redis client from
# EXACTLY these names and fails fast (loud error, no silent no-op) if either is
# missing, so a misconfiguration can never quietly disable rate limiting.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend API key — used by /api/contact to deliver contact-form submissions
# as email. If unset, submissions are logged to stdout (local dev fallback).
RESEND_API_KEY=

# Inbox that receives contact-form submissions (e.g. vertrieb@motionsports.de).
# Must be set together with RESEND_API_KEY for email to be sent.
CONTACT_TO_EMAIL=

# Verified Resend sender (e.g. "Motion Sports <kontakt@motionsports.de>").
# The domain must be verified in your Resend dashboard. ALSO used as the
# "from" address for the email-capture flow (summary, DOI confirmation).
CONTACT_FROM_EMAIL=

# --- Email capture + double opt-in (GDPR) -----------------------------------
# Public base URL of THIS backend, used to build the absolute links that go
# into emails (DOI confirmation, unsubscribe). e.g. https://mo.motionsports.de
# If unset, the backend falls back to Vercel's injected host, then the request
# origin. Set it explicitly in production so links are always correct.
PUBLIC_BASE_URL=

# Days a marketing double-opt-in (DOI) confirmation token stays valid, measured
# from when it was sent. After this, /api/confirm-marketing rejects it. Default 7.
MARKETING_DOI_EXPIRY_DAYS=7

# Secret used to sign the email-keyed unsubscribe links (HMAC-SHA256). If unset,
# CHAT_SHARED_SECRET is used as a fallback. Set a dedicated long random string so
# rotating the chat secret doesn't invalidate every outstanding unsubscribe link.
UNSUBSCRIBE_SECRET=

# --- Inbound email (Resend Inbound — receive replies) -----------------------
# The unified mail log (email_messages, migration 0021) + the inbound webhook
# /api/inbound/resend. See docs/archive/EMAIL_SUBSYSTEM_SPIKE.md.

# The DEDICATED address Resend Inbound receives replies on (currently a TEST
# address; the production swap is env-only — never hardcoded). Point its MX at
# Resend and verify the domain. Set as Reply-To on every outbound mail so a
# customer's reply routes to inbound and threads back. Use a dedicated inbound
# subdomain with its own MX record at Resend, e.g. hello@reply.motionsports.de
# (the app domain mo.motionsports.de is a CNAME to Vercel and cannot carry an MX)
# — NOT the corporate MX / kontakt@ sender. If unset, outbound mail simply omits
# the Reply-To (no behaviour change). Every incoming mail of a known customer
# opens an Eingang item „E-Mail beantworten“ (docs/ADMIN_DASHBOARD.md §3.1).
INBOUND_EMAIL_ADDRESS=

# Svix signing secret (whsec_…) for the Resend Inbound webhook. The route
# verifies every payload's signature over the RAW body BEFORE parsing; without
# this set, /api/inbound/resend fails closed (503) and ingests nothing.
RESEND_WEBHOOK_SECRET=
# Signing secret of a SEPARATE Resend webhook for delivery events (email.bounced,
# email.complained, email.delivered) pointing at /api/webhooks/resend. Leave
# empty when those events are added to the same webhook as the inbound route.
RESEND_EVENTS_WEBHOOK_SECRET=

# Server-side switch for the returning-customer hint served alongside the
# capture-form consent copy (returningHint.enabled in GET /api/consent-copy
# and the offer_email_summary tool result). DEFAULT TRUE; set false to make
# the widget hide the hint without a theme release.
RETURNING_HINT_ENABLED=true

# --- Physical mail (Pingen → Deutsche Post) ---------------------------------
# The physical-letter channel (physical_letters, migration 0022) + the Pingen
# REST client (lib/pingen) + the status webhook /api/webhooks/pingen. There is
# NO JS/TS Pingen SDK — we call the REST API directly. See
# docs/archive/EMAIL_SUBSYSTEM_SPIKE.md §4.

# OAuth2 client_credentials app (identity.pingen.com → api.pingen.com), scoped
# by the organisation UUID. Create a Developer App in the Pingen dashboard.
PINGEN_CLIENT_ID=
PINGEN_CLIENT_SECRET=
PINGEN_ORGANISATION_ID=

# Use the FREE staging environment (api-staging.pingen.com /
# identity-staging.pingen.com), which mirrors production for end-to-end tests.
# Any of 1/true/yes/on selects staging; default (unset) is PRODUCTION.
PINGEN_STAGING=true

# Standard-webhooks signing secret(s) (whsec_…) for the Pingen status webhook.
# The route verifies every payload over the RAW body BEFORE parsing; without this
# set, /api/webhooks/pingen fails closed (503) and ingests nothing.
# Pingen issues a SEPARATE secret per event-type subscription (Sent / Delivered /
# Undeliverable / Document Issues), all pointing at the same webhook URL — so set
# a COMMA-SEPARATED LIST of all of them here (an event verifies if it matches any
# one). A single shared secret across all subscriptions also works.
#   e.g. PINGEN_WEBHOOK_SECRET=whsec_aaa,whsec_bbb,whsec_ccc,whsec_ddd
PINGEN_WEBHOOK_SECRET=

# Sign-off gate for REAL physical sends — Pingen is a NEW DATA PROCESSOR
# (recipient address → Pingen/CH → Deutsche Post) needing its own AV-Vertrag
# (DPA) + a CH third-country transfer note. The whole physical-send path (client,
# table, PDF render, webhook) is BUILT regardless, and stays OFF (fail-closed,
# default false) until sign-off. APPROVED by Legal (2026-06-14) — PRODUCTION
# enables it in the Vercel project. This example ships `false` so a fresh copy
# never sends real letters; only 1/true/yes/on enable it. SEPARATE from
# CONSENT_COPY_LAWYER_APPROVED.
PHYSICAL_MAIL_SENDS_APPROVED=false

# How long physical_letters rows are kept (audit), in days (default 365). Its
# own category (a letter is NOT email); purged by /api/cron/retention. 0 disables.
PHYSICAL_LETTER_RETENTION_DAYS=365

# Fallback postage cost per letter in CENTS, used in the KPI cost total when
# Pingen hasn't reported a price for a letter (e.g. staging). Default 106 (1,06 €).
PINGEN_LETTER_COST_CENTS=106

# Letters as a campaign channel (migration 0074, docs/CAMPAIGNS.md §8). Gated by
# PHYSICAL_MAIL_SENDS_APPROVED + Pingen like every letter; each campaign picks
# its own letter mode (default „Keine Briefe“) and every letter is released one
# by one on the desk („Briefe“ view).
# Minimum days between two campaign letters to one person. Default 60; 0 = no
# cadence check.
LETTER_MIN_INTERVAL_DAYS=60
# Purchase addresses (shipping address of the latest completed order) fetched
# per night for open letter recipients of active campaigns, by the
# campaign-audiences cron. Default 200, max 2000; 0 = only the desk's button.
CAMPAIGN_LETTER_ADDRESS_NIGHTLY=200
# Shop address the AI letter drafts may name (plain text on paper, no link).
# Default: the host of the first ALLOWED_ORIGINS entry, else www.motionsports.de.
CAMPAIGN_LETTER_SHOP_URL=

# --- Admin marketing dashboard ----------------------------------------------
# Single shared password protecting /admin and /api/admin/*. The login server
# action checks the submitted password against this (constant-time) and, on
# success, sets a signed HTTP-only session cookie. If unset, the admin login is
# disabled (fails closed). Use a long, random passphrase. Login attempts are
# rate-limited to 10 per 10 minutes per IP via the Upstash bucket below
# (KV_REST_API_*); without KV the limiter fails OPEN so an operator is never
# locked out.
ADMIN_PASSWORD=

# Secret used to HMAC-sign the admin session cookie. Prefer a dedicated long
# random string; if unset, CHAT_SHARED_SECRET is used as a fallback. Rotating
# this invalidates all outstanding admin sessions.
ADMIN_SESSION_SECRET=

# Days a generated single-use marketing discount code stays valid (endsAt =
# mint time + N days). Default 7. The marketing email states this validity
# period and the concrete expiry date next to the call-to-action.
MARKETING_DISCOUNT_EXPIRY_DAYS=7

# How far back (days) the "chatted but not purchased" check looks for a Shopify
# order from a confirmed marketing contact's email. Default 180.
MARKETING_ORDER_LOOKBACK_DAYS=180

# Per-recipient marketing send-frequency cap: minimum days between two marketing
# emails to the SAME address (approveAndSend refuses an earlier re-send with
# HTTP 429). The cadence is a policy choice; default 0 = disabled (set e.g. 14).
# ALSO enforced by the campaign channel (Kampagne tab) — the cap spans BOTH
# channels in both directions: a customer who just got a Mo-marketing email is
# not sent a campaign email inside the window, and vice versa.
MARKETING_MIN_SEND_INTERVAL_DAYS=0

# Daily conversion sweep (marks a consultation "konvertiert" when its unique
# Mo code shows up in a paid Shopify order): codes checked per run. Default 25,
# 0 disables the sweep.
CONVERSION_SWEEP_MAX_CODES=25

# --- Kampagnen-Modul (campaign emails to Shopify marketing subscribers) ------
# Personalized emails to the shop's EXISTING Shopify customer base — customers
# who ticked Shopify's marketing checkbox (login/checkout) and have order
# history. See docs/CAMPAIGNS.md. Requires the read_customers Admin API scope
# (audience sync); customer email/name is PROTECTED CUSTOMER DATA — see the
# SHOPIFY_CLIENT_ID note below.

# MASTER send gate for the campaign channel. ⚠️ This audience's consent comes
# from Shopify's marketing checkbox, NOT from our own double-opt-in flow —
# German case law effectively requires a provable double opt-in, so the channel
# was BUILT disabled (fail-closed; the code treats an absent/empty value as
# false). While false, EVERY campaign send is refused server-side (UI button
# disabled AND the send route refuses); drafts, preview and Copy keep working.
# APPROVED by the lawyer for this channel (2026-07-21) — PRODUCTION enables it
# in the Vercel project. This example ships `false` so a fresh copy never
# sends; only 1/true/yes/on enable. SEPARATE from CONSENT_COPY_LAWYER_APPROVED
# (DOI marketing copy) and PHYSICAL_MAIL_SENDS_APPROVED (Pingen).
CAMPAIGN_SENDS_APPROVED=false

# Per-contact opt-in-level gate. Shopify records the consent quality as
# emailMarketingConsent.marketingOptInLevel (CONFIRMED_OPT_IN | SINGLE_OPT_IN |
# UNKNOWN). Contacts WITHOUT a provable double opt-in (SINGLE_OPT_IN/UNKNOWN)
# stay visible in the queue but send-blocked ("Erneute Einwilligung
# erforderlich"; Copy still works) while this is false. Covered by the
# 2026-07-21 lawyer approval — PRODUCTION enables it in the Vercel project;
# this example ships `false`. Only 1/true/yes/on enable.
CAMPAIGN_ALLOW_SINGLE_OPT_IN=false

# Deep link the Mo-promo block at the end of every campaign email points at —
# theme-side handling (docs/CAMPAIGNS.md Task F): `mo=open` auto-opens the chat
# widget after init; `mo_new=1` starts a FRESH consultation (no old thread
# resumed) and `mo_view=fullscreen` opens the panel in full-screen mode.
# Appended deterministically at send time, never editable prose. Default below.
CAMPAIGN_MO_DEEPLINK_URL=https://motionsports.de/?mo=open&mo_new=1&mo_view=fullscreen&utm_source=campaign&utm_medium=email

# Nightly „Vorbereiten“ (/api/cron/prepare-campaign-drafts, 04:15 UTC): the
# nightly BUDGET of drafts across all campaigns. Each active campaign takes its
# own „Automatisch vorbereiten“ figure (Kampagne bearbeiten → Automatik) from
# it, highest priority first. When no campaign sets a figure, the whole budget
# goes to the Lebenszyklus campaign with the three settings below (the
# behaviour before campaigns). Generation costs API money, so this ships OFF —
# 0 (the default) makes the cron skip. Set e.g. 200 for a 200-a-day rhythm.
CAMPAIGN_AUTO_PREPARE_COUNT=0

# Discount depth (whole percent, 0–50; default 0 = no code) and text mode
# (detailed | compact | minimal; default compact) for the nightly drafts of the
# Lebenszyklus campaign in the fallback above (campaigns with their own figure
# use their own offer settings).
CAMPAIGN_AUTO_PREPARE_DISCOUNT=0
CAMPAIGN_AUTO_PREPARE_TEXT_MODE=compact

# What the nightly drafts' discount code applies to: all (the whole order,
# default) | recommendations (only the products recommended in the mail) |
# set (only the attached set). The desk's popover offers the same choice;
# every draft can change it later on the review card.
CAMPAIGN_AUTO_PREPARE_DISCOUNT_SCOPE=all

# „Einplanen“ (migration 0072): approve a reviewed campaign mail now, send it
# later. The desk offers the action (key A) and the release job
# /api/cron/release-campaign-mails (every 10 min) sends due mails — one at a
# time through approveAndSendCampaign, so every legal gate runs again at send
# time; changed or refused mails return to the queue. Default false.
CAMPAIGN_RELEASE_ENABLED=false
# Pace of the release job: at most this many mails per run (1–200, default 30)
# with this many milliseconds between two sends (500–60000, default 1500;
# Resend's default limit is about 2 requests/s shared with every other mail).
CAMPAIGN_RELEASE_MAX_PER_RUN=30
CAMPAIGN_RELEASE_SPACING_MS=1500

# --- Shopify catalog sync ---------------------------------------------------
# As of January 2026 the Shopify admin no longer exposes a static shpat_
# access token. Apps created in the Developer Dashboard get a Client ID and
# Client Secret (shpss_…); the backend exchanges them for a short-lived
# Admin API token via the OAuth client-credentials grant. Run
# `npm run verify:shopify` after filling these in to confirm auth works.

# The store's *.myshopify.com domain (NOT the public domain).
# Example: motion-sports.myshopify.com
SHOPIFY_STORE_DOMAIN=

# App Client ID from the Shopify Developer Dashboard.
# Required scopes: read_products + write_products (catalog sync), and for the
# admin marketing dashboard write_discounts (code creation) + read_orders
# (the "chatted but not purchased" check). Reading an order's email is protected
# customer data — the app may also need Protected Customer Data access approved.
#
# CUSTOMER PLATFORM (docs/CUSTOMER_PLATFORM_PLAN.md) additionally requires
# read_customers (the mirror: import, webhooks, reconcile) and write_customers
# (writing the one consent back, creating Shopify customers for Mo-only
# subscribers, requesting erasure), plus read_all_orders if orders older than
# 60 days must be imported. ⚠️ Customer email/name is PROTECTED CUSTOMER DATA:
# the app needs Protected Customer Data access (incl. the name/email
# field-level approvals) granted in the Shopify Partner dashboard, the same
# caveat as the read_orders usage above. Client-credentials tokens only carry
# scopes granted at install — REINSTALL the app after adding scopes.
#
# The real-time stock webhook (inventory_levels/update) requires read_inventory;
# without it `npm run shopify:webhooks -- --apply` cannot subscribe to the topic.
#
# BUNDLE OFFERS additionally require read_publications + write_publications — the
# bundle is published to the Online Store via publishablePublish, which fails
# with ACCESS_DENIED without them (for BOTH the native and the fallback path; see
# docs/BUNDLES.md). With these two added, the documented required-scope set is
# 17 scopes (the original spike listed 15). Client-credentials tokens only carry
# scopes granted at install, so REINSTALL the app on the store after adding them.
SHOPIFY_CLIENT_ID=

# App Client Secret (shpss_…) from the Shopify Developer Dashboard.
SHOPIFY_CLIENT_SECRET=

# Secret used to verify Shopify App Proxy signatures on /api/auth/storefront
# (storefront-initiated sign-in). Optional — falls back to SHOPIFY_CLIENT_SECRET,
# which is the app's API secret key in the usual single-app setup.
SHOPIFY_APP_PROXY_SECRET=

# Admin API version to target. Use the current stable, e.g. 2026-04.
# See https://shopify.dev/docs/api/usage/versioning
SHOPIFY_API_VERSION=2026-04

# Signing secret for the real-time stock webhook (/api/webhooks/shopify). The
# route verifies every payload's X-Shopify-Hmac-SHA256 over the RAW body BEFORE
# parsing; a signature valid under SHOPIFY_WEBHOOK_SECRET OR SHOPIFY_CLIENT_SECRET
# is accepted — with neither set, the route fails closed (503) and ingests nothing.
# Subscriptions made in the Shopify admin (Settings → Notifications → Webhooks)
# are signed with the store's key shown there (put it here); subscriptions made
# by the app — `npm run shopify:webhooks -- --apply`, the app configuration and
# the compliance topics — are signed with the app's client secret. Register the topics
# products/update, products/create, products/delete and inventory_levels/update
# against https://<deployment>/api/webhooks/shopify — see docs/CATALOG_SYNC.md.
# The customer platform adds customers/create, customers/update,
# customers/delete, customers_email_marketing_consent/update, orders/create,
# orders/updated, orders/paid, orders/cancelled, bulk_operations/finish and the
# mandatory compliance topics customers/data_request, customers/redact,
# shop/redact (all to the same URL — docs/CUSTOMER_PLATFORM_PLAN.md §6).
# `npm run shopify:webhooks` lists what exists and what is missing (and checks
# the scopes); `-- --apply` creates the missing subscriptions. The compliance
# topics are set in the app configuration (Dev Dashboard → Compliance webhooks).
SHOPIFY_WEBHOOK_SECRET=

# --- Customer platform: Shopify sync switches (all default OFF) --------------
# docs/CUSTOMER_PLATFORM_PLAN.md. Turn them on in this order: sync → import
# (Einstellungen → Shopify-Abgleich) → consent write-back → erasure sync.
#
# Mirror the Shopify customers and their orders (import, customer/order/consent
# webhooks, the nightly /api/cron/shopify-reconcile). While false, those webhooks
# are acknowledged without writing anything (order attribution keeps working;
# deletions and the compliance topics are always handled). Default false.
SHOPIFY_CUSTOMER_SYNC_ENABLED=false
# Write consent changes made in Mo (DOI confirmed, unsubscribe, admin opt-out,
# complaint) back to Shopify, and create a Shopify customer for a Mo-only
# subscriber, via the outbox (/api/cron/shopify-sync, every 5 min). Default false.
SHOPIFY_CONSENT_WRITEBACK=false
# Ask Shopify to erase the customer when a person is erased in Mo (consent off
# first, then customerRequestDataErasure). Default false.
SHOPIFY_ERASURE_SYNC=false
# Write Mo's insights back to Shopify as customer tags (mo-segment-…, mo-wert-…,
# mo-kontakt, mo-abwanderung-hoch) after the nightly facts run, through the
# outbox — usable in Shopify segments, Flow and Shopify Email. The shop's own
# tags are never touched. Default false (plan D-11).
SHOPIFY_WRITEBACK_ENABLED=false
# The consent text version stamped on consent acts that come from Shopify
# (consent_events.text_version) — the checkout/account wording in force.
SHOPIFY_CONSENT_TEXT_VERSION=shopify-2026-10
# Alert threshold: more erasures per hour than this (from Shopify webhooks)
# raise an error report — a mass deletion should never go unnoticed. Default 20.
SHOPIFY_ERASURE_ALERT_PER_HOUR=20

# --- Shopify Customer Account sign-in (tier-3 identity) ----------------------
# SEPARATE client from the Admin one above (different credentials + host). Used
# for the OAuth 2.0 authorization-code + PKCE (S256) customer sign-in. See
# docs/CUSTOMER_ACCOUNT.md and run `npm run verify:customer-account` to execute
# the verify gate (discovery + token-endpoint client auth + prompt=none).

# Customer Account API client id (PUBLIC client — this is NOT a secret; it
# appears in the browser's authorization URL by design). Get it from Shopify
# admin → Headless → Customer Account API. Set it in the deployment env; left
# blank here to match the other credential fields (and keep secret scanners
# happy — an unset example value can never be mistaken for a leaked one).
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=

# Customer Account API client SECRET — leave EMPTY for the confirmed PUBLIC
# (PKCE, no-secret) setup. Set ONLY if the verify gate reports the token
# endpoint rejected the public exchange and the client was switched to
# Confidential in Shopify admin; the backend then uses client_secret_basic.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=

# Public storefront domain that hosts the discovery documents
# (/.well-known/openid-configuration + /.well-known/customer-account-api).
# Default www.motionsports.de. The auth itself happens on the Shopify-managed
# account.<domain> subdomain (read from discovery — never hardcoded).
SHOPIFY_STOREFRONT_DOMAIN=www.motionsports.de

# 32-byte key used to encrypt the customer OAuth tokens at rest (AES-256-GCM,
# customer_oauth_tokens). 64 hex chars, or 32-byte base64, or a 32-byte raw
# string. Generate e.g.: openssl rand -hex 32. REQUIRED for sign-in token
# storage — the callback fails closed without it.
TOKEN_ENC_KEY=

# Secret used to HMAC-sign the OAuth `state`. Prefer a dedicated long random
# string; if unset, CHAT_SHARED_SECRET is used as a fallback.
SHOPIFY_CUSTOMER_ACCOUNT_STATE_SECRET=

# How long a pending-auth record (CSRF state + PKCE verifier) stays valid
# between /api/auth/shopify/login and the callback. Default 10 (minutes).
CUSTOMER_AUTH_PENDING_TTL_MINUTES=10

# --- Order status in the chat (get_order_status) -----------------------------
# Lets a customer who signed in with the Customer Account IN THE SAME chat
# session ask Mo about their own orders (status, shipping, delivery, refund
# state). Mo answers from the local order ledger plus a short live read from
# Shopify; order numbers, amounts, tracking numbers and addresses never reach
# the model. Returns, cancellations and complaints still go to the contact
# form. Default false (fail closed) — while off the tool is withheld and the
# prompt is unchanged. Turn on only after the lawyer's answer (F-32) and after
# checking the live widget renders nothing for the new tool
# (docs/ANWALTSDOSSIER.md §16, docs/ROLLOUT_TODO.md).
CHAT_ORDER_STATUS_ENABLED=false

# Live check before the switch: Shopify customer ids (digits or
# gid://shopify/Customer/…, comma or space separated, max 20) for whom the
# order status already works while CHAT_ORDER_STATUS_ENABLED is false — only
# when signed in to the chat with that customer account in that session.
# Default empty (nobody). Remove the ids once the flag is on.
CHAT_ORDER_STATUS_TEST_CUSTOMERS=

# The generic "Meine Bestellungen" page Mo links to with an order status
# answer (no order-specific link). Default https://www.motionsports.de/account
# (the shop's customer account, which leads to the order list).
SHOPIFY_ACCOUNT_ORDERS_URL=

# --- Catalog sync storage + scheduling --------------------------------------
# Vercel Blob token used to read/write the cached catalog + embeddings
# (keys: catalog/product-catalog.json, catalog/product-embeddings.json).
# If unset the runtime falls back to the committed JSON in src/data/.
BLOB_READ_WRITE_TOKEN=

# Shared secret Vercel Cron sends as `Authorization: Bearer <secret>` to the
# crons: /api/cron/sync-catalog, /api/cron/retention, /api/cron/expire-bundles,
# /api/cron/refresh-customers, /api/cron/shopify-reconcile,
# /api/cron/shopify-sync, /api/cron/campaign-audiences,
# /api/cron/prepare-campaign-drafts and /api/cron/inbox (see vercel.json).
# Generate a long random string.
CRON_SECRET=

# --- Scheduled customer-data refresh (/api/cron/refresh-customers, daily) ----
# Keeps each customer's cached Shopify data (order history + lawful postal
# address) fresh automatically, so drafts are never built on stale data, and
# then keeps the central AI customer profile current (see docs/CUSTOMERS.md).
# All have sane defaults.
# Customers per run (most-stale first; daily runs sweep the whole base).
CUSTOMER_REFRESH_BATCH=25
# Only refresh a customer whose data is older than this many hours.
CUSTOMER_REFRESH_STALE_HOURS=24
# Profiles regenerated per nightly run: customers with new activity since their
# last profile (or never profiled) first. One profile ≈ $0.10 (deep tier).
# Default 30; 0 disables the automatic upkeep (the "Neu generieren" button and
# `npm run profiles:backfill` still work). This batch covers the Vollprofile:
# people with a Mo chat or e-mail correspondence.
CUSTOMER_PROFILE_BATCH=30
# Kaufprofile per nightly run: Shopify customers with orders but no chat — a
# short purchase-only profile on the writer tier (≈ $0.01 each). Default 0
# (off); e.g. 200 builds the base over a few weeks.
CUSTOMER_PROFILE_LIGHT_BATCH=0
# Who gets an AI profile at all: consented (default — only people with the one
# consent for e-mail advertising) | all (everyone; people without consent are
# flagged in Kunden and every advertising action stays blocked). An Art. 21
# objection always wins. Decided for this shop: all (lawyer to confirm).
CUSTOMER_AI_PROFILE_SCOPE=consented

# --- Eingang (operator inbox) -------------------------------------------------
# AI suggestions written per day by /api/cron/inbox for the highest-priority
# open items (writer tier, ≈ $0.01 each). Default 0 (off — the operator can
# still request one per item). Recommended 25.
INBOX_AI_DAILY_LIMIT=0

# --- Bundle offers (optional — defaults are sane) ---------------------------
# Personalized bundle offers (see docs/BUNDLES.md). The "create the Shopify
# product" step is behind a seam selected by this flag:
#   native_fixed_bundle    (default) — real Shopify fixed bundle, native
#                                       component-inventory linkage. VERIFIED GO.
#   plain_unlisted_product            — fallback: a plain UNLISTED product priced
#                                       at the bundle total, components in the
#                                       description (NO native inventory linkage).
BUNDLE_CREATION_MODE=native_fixed_bundle

# Days an offer stays live before it ends and the expiry cron deletes its Shopify product (default 7).
BUNDLE_OFFER_EXPIRY_DAYS=7

# Where the friendly "Angebot abgelaufen" page sends a late click ("Zum Shop").
# Defaults to the storefront root; set to a collection for something sharper.
BUNDLE_EXPIRED_REDIRECT_URL=

# --- Observability (optional) ----------------------------------------------
# Sentry DSN for server-side error capture — ERRORS ONLY. tracesSampleRate is
# pinned to 0 in code, so no performance/transaction events are sent (we don't
# spend the free-tier quota on traces). If unset, Sentry init is skipped cleanly
# and errors are logged to stdout only — the routes never crash on missing
# observability config, but a one-time warning is logged so a missing DSN is
# visible, not silent.
#
# This is the SINGLE Sentry DSN var (do NOT add a separate SENTRY_DSN). The
# Vercel Sentry integration injects it automatically in deployed environments;
# set it here only for local error reporting. A DSN is NOT a secret — it ships
# in client bundles by design.
NEXT_PUBLIC_SENTRY_DSN=

# NOTE: the Sentry Next.js build plugin (source-map upload) is NOT wired into
# next.config.ts — Sentry is used for error capture only (lib/observability),
# so SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN are not read by this
# project.

# --- AI cost tracking (optional — KPI tab) ----------------------------------
# Token usage from every AI call (chat, email drafts, summaries, embeddings) is
# recorded and turned into a EUR "cost per consultation" on the KPI tab. Prices
# change, so the model→price table can be overridden without a code change.

# JSON object mapping model id → { input, output } in USD per MILLION tokens.
# Overrides/extends the built-in defaults (sane values for the models we use).
# Example:
#   MODEL_PRICES_JSON={"claude-sonnet-4-5-20250929":{"input":3,"output":15},"claude-opus-4-8":{"input":5,"output":25}}
# NB: TTS models (e.g. gpt-4o-mini-tts) are billed per CHARACTER, so for those
# the `input` value is USD per million CHARACTERS and `output` is 0 — the TTS
# usage rows store characters synthesized in the input column.
# Leave unset to use the built-in defaults.
MODEL_PRICES_JSON=

# USD→EUR conversion rate applied to computed costs. Default 0.92.
USD_EUR_RATE=0.92

# --- Database (Vercel Postgres / Neon) --------------------------------------
# As of 2026 Vercel Postgres is the Neon native integration. Installing it
# from the Vercel Marketplace injects these automatically — you normally do
# NOT set them by hand in production. They're listed here so local dev and the
# `npm run db:migrate` script know what to provide.
#
# Pooled connection (used by the serverless routes for short queries). The
# integration also injects the legacy POSTGRES_URL with the same value.
DATABASE_URL=

# Direct/unpooled connection (used by migrations and other DDL-heavy work).
# The integration also injects the legacy POSTGRES_URL_NON_POOLING. If unset,
# the pooled URL is used as a fallback.
DATABASE_URL_UNPOOLED=

# LOCAL DEVELOPMENT ONLY — point the Neon HTTP driver at the local protocol proxy
# (`npm run db:proxy`) so the app can use a plain Postgres on your machine.
# See docs/DATABASE.md → "Local database". Leave unset in every deployment.
NEON_FETCH_ENDPOINT=

# --- Data retention (optional — sensible defaults baked in) ------------------
# Enforced daily by /api/cron/retention (protected by the existing CRON_SECRET
# above). See docs/DATA_RETENTION.md. All values are in days except the
# abandonment window (minutes). Leave unset to use the defaults shown.
# ONE rule for every window: `0` DISABLES that step (nothing is deleted),
# an invalid or negative value falls back to the default. There is no window
# that deletes everything.

# Conversations + messages older than this (by last_activity_at) are deleted.
# 0 disables.
RETENTION_DAYS=180

# kpi_events older than this (by created_at) are deleted. Also governs the
# dashboard/admin AI-usage rows (ai_usage rows with no conversation); chat
# AI-usage rows cascade with their conversation under RETENTION_DAYS. Also the
# window of the derived analytics caches (insights rollups, persona summaries)
# and the pseudonymous mo_orders rows. 0 disables.
KPI_RETENTION_DAYS=180

# Idle 'active' conversations older than this are flipped to 'abandoned'.
# 0 disables.
ABANDON_AFTER_MINUTES=30

# Order attribution (docs/ORDER_ATTRIBUTION.md): max days between an
# attribution token's minting and an order for the order to count as
# Mo-attributed. Also drives the token purge (window + 7 days grace).
MO_ATTRIBUTION_WINDOW_DAYS=30

# Grace period before unsubscribed/suppressed email_captures are purged.
# The suppression_list entry itself is always kept to honour the opt-out.
# 0 disables.
SUPPRESSED_CAPTURE_PURGE_DAYS=30

# Correspondence (email_messages, by occurred_at) is purged on its OWN schedule
# — it's its own data category (Korrespondenz / Art. 6(1)(b)/(f)), not marketing
# consent. Default 365 (longer than the analytics window; pending Legal sign-off).
# 0 disables.
CORRESPONDENCE_RETENTION_DAYS=365

# Free-text customer feedback (feedback table, by created_at) — can carry
# user-supplied PII, so it doesn't live forever. Default 365. 0 disables.
FEEDBACK_RETENTION_DAYS=365

# Storage limitation (Art. 5(1)(e)): purge IDENTIFIED but DORMANT customers whose
# last_seen_at is older than this — EXCEPT those holding an active marketing
# consent (the one consent subscribed/pending), which is its own basis to
# retain, and Shopify customers (the mirror follows Shopify). Their
# conversations/correspondence return to pseudonymous rows (ON DELETE SET NULL)
# and their OAuth tokens cascade away. Conservative 3-year (1095) default; the
# exact window is a policy call — confirm with Legal. 0 disables.
CUSTOMER_INACTIVITY_RETENTION_DAYS=1095

# Admin PII-access audit log (admin_access_log, by occurred_at) — a security
# record of which customer's data an operator pulled. Default 730 (2 years).
# 0 disables.
ADMIN_ACCESS_LOG_RETENTION_DAYS=730

# Campaign recipients + send records (campaign_contacts by last refresh /
# creation, campaign_sends by sent_at) — purged by /api/cron/retention on their
# own window. An open recipient keeps refreshing last_synced_at at every
# audience refresh and stays; a sent or dropped one ages out. The
# suppression_list is never touched — opt-outs are honoured forever.
# Default 365. 0 disables.
CAMPAIGN_CONTACT_RETENTION_DAYS=365

# Shopify sync bookkeeping (webhook dedupe rows, finished sync runs, done /
# dead outbox rows). The newest finished run per kind always stays. Default 90.
# 0 disables.
SHOPIFY_SYNC_LOG_RETENTION_DAYS=90

# Decided Eingang items (erledigt / verworfen): after this many days their
# content (reason, evidence, AI suggestion, note) is removed and only a marker
# stays (kind, customer, decision), so a decided item is not re-created; the
# marker is deleted after two years or with the customer. Default 180. 0 disables.
INBOX_RETENTION_DAYS=180

# Erasure tombstones (Shopify ids of people erased in Mo, so no import re-creates
# them): removed this many days after Shopify confirmed the redaction
# (customers/redact). Unconfirmed tombstones always stay. Default 30. 0 disables.
ERASURE_TOMBSTONE_RETENTION_DAYS=30

# Stored Komplettanalyse reports (analytics_reports, by created_at) — reports
# generated with per-customer profiles carry customer display names and must
# not live forever. Default 365. 0 disables.
ANALYTICS_REPORT_RETENTION_DAYS=365

# --- E-Mail-Assets (optional) -----------------------------------------------
# Logo shown in the header of every branded e-mail. Unset = the built-in
# motion sports logo. A design's own logo (if it defines one) wins over this.
EMAIL_LOGO_URL=
# The small "Mo" icon in e-mails (default <BASE_URL>/moorb.gif). Override to
# host a different asset.
EMAIL_MO_ICON_URL=

# --- E-Mail-Hero-Bilder (Design "Performance", docs/EMAIL_DESIGNS.md) --------
# Standard-Hero-Bild der bild-orientierten E-Mail-Designs. Ohne diese Variable
# wird <BASE_URL>/email-hero-default.jpg verwendet — die Datei dazu liegt in
# public/email-hero-default.jpg (Hochformat, ca. 1024x1536). Die individuelle
# Hero-Generierung je E-Mail nutzt OPENAI_API_KEY + BLOB_READ_WRITE_TOKEN.
EMAIL_HERO_DEFAULT_URL=
# Hero-Bildmodell (Standard gpt-image-2) und Qualität (low | medium | high, Standard high).
EMAIL_HERO_IMAGE_MODEL=
EMAIL_HERO_IMAGE_QUALITY=
# "off" = keine Katalogfotos der Produkte als Referenzen mitschicken (Standard: an).
EMAIL_HERO_REFERENCES=
# "off" = keine automatische Bildprüfung mit Re-Render (Standard: an, wenn ANTHROPIC_API_KEY gesetzt).
EMAIL_HERO_QA=
# Absolute URL des offiziellen EU-Icons für KI-generierte Inhalte (PNG, von der
# Kommissions-Seite laden und unter public/ ablegen, z. B. https://mo.motionsports.de/eu-ai-icon.png).
# Leer = Kennzeichnung nur als Text „KI-generiertes Bild" (weiterhin erfüllt).
EMAIL_AI_LABEL_ICON_URL=
